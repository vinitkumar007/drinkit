# Copy to .env (or set these in your host). Never commit real secrets.
NODE_ENV=production
PORT=3000
# Long random string. Required when NODE_ENV=production:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Where the SQLite file lives (put it on a persistent volume)
DB_FILE=/data/drinkit.db
# Optional tuning
AUTH_RATE_MAX=30
# Only for demos/tests: skip store opening-hours check
# IGNORE_STORE_HOURS=1
