# Copy these into your host's environment settings (Render -> Environment). Do not commit a real .env file.
APP_ENV=production            # NODE_ENV=production works too
JWT_SECRET=change-me-to-a-long-random-text
STAFF_PASSWORD=Drinkit@2026   # one password for every admin / rider account, min 8 characters
DEMO_OTP=1                    # shows the customer OTP on screen (demo only). Remove when SMS is connected.
# DB_FILE=/data/drinkit       # H2 database file path (no extension). Default ./data/drinkit
# PORT=3000
# AUTH_RATE_MAX=30            # OTP requests per 15 min per IP
# STAFF_RATE_MAX=10           # staff login attempts per 15 min per IP
# IGNORE_STORE_HOURS=1        # testing only: ignore the 10:00-22:00 store hours
